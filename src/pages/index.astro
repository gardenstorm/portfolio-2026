---
// index.astro — Coming Soon page
// Place your sunset photo at: public/assets/sunset.jpg
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio — Coming Soon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Satisfy&family=Faculty+Glyphic&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --warm-glow: rgba(255, 160, 60, 0.15);
        --text-primary: #fdf6ee;
        --text-muted: rgba(253, 246, 238, 0.65);
        --accent: #f4a14a;
      }

      html, body {
        height: 100%;
        width: 100%;
        overflow: hidden;
      }

      body {
        font-family: 'Faculty Graphic', sans-serif;
        font-weight: 300;
        background: #0e0a06;
      }

      /* ── Background ── */
      .bg {
        position: fixed;
        inset: 0;
        background-image: url('/assets/sunset.jpg');
        background-size: cover;
        background-position: center 40%;
        z-index: 0;
        animation: slowZoom 30s ease-in-out infinite alternate;
      }

      @keyframes slowZoom {
        from { transform: scale(1); }
        to   { transform: scale(1.06); }
      }

      /* ── Overlays ── */
      .overlay-dark {
        position: fixed;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(8, 4, 2, 0.82) 0%,
          rgba(8, 4, 2, 0.35) 45%,
          rgba(8, 4, 2, 0.15) 100%
        );
        z-index: 1;
      }

      .overlay-vignette {
        position: fixed;
        inset: 0;
        background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.5) 100%);
        z-index: 2;
      }

      /* ── Layout ── */
      .stage {
        position: relative;
        z-index: 10;
        height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-start;
        padding: clamp(2rem, 6vw, 5rem);
        gap: 0;
      }

      /* ── Eyebrow ── */
      .eyebrow {
        font-family: 'Faculty Glyphic', sans-serif;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.5rem;
        opacity: 0;
        transform: translateY(12px);
        animation: rise 0.9s ease forwards 0.2s;
      }

      /* ── Main heading ── */
      .heading {
        font-family: 'Satisfy', cursive;
        font-weight: 400;
        font-size: clamp(5rem, 16vw, 14rem);
        line-height: 0.88;
        color: var(--text-primary);
        letter-spacing: -0.01em;
        opacity: 0;
        transform: translateY(20px);
        animation: rise 1s ease forwards 0.45s;
      }

      /* ── Divider ── */
      .rule {
        width: clamp(3rem, 8vw, 7rem);
        height: 1px;
        background: linear-gradient(to right, var(--accent), transparent);
        margin: 1.6rem 0 1.4rem;
        opacity: 0;
        animation: rise 0.8s ease forwards 0.75s;
      }

      /* ── Blurb ── */
      .blurb {
        font-family: 'Faculty Glyphic', sans-serif;
        font-weight: 400;
        font-size: clamp(0.95rem, 2vw, 1.25rem);
        letter-spacing: 0.08em;
        color: var(--text-primary);
        line-height: 1.6;
        opacity: 0;
        transform: translateY(10px);
        animation: rise 0.9s ease forwards 0.9s;
      }

      .blurb span {
        display: block;
      }

      /* ── Social row ── */
      .social-row {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-top: 2.2rem;
        opacity: 0;
        transform: translateY(10px);
        animation: rise 0.9s ease forwards 1.1s;
      }

      .social-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        text-decoration: none;
        font-family: 'Faculty Glyphic', sans-serif;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        transition: color 0.3s ease;
      }

      .social-link:hover {
        color: var(--accent);
      }

      .social-link svg {
        width: 16px;
        height: 16px;
        fill: currentColor;
        flex-shrink: 0;
      }

      .social-dot {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--text-muted);
      }

      /* ── Corner badge ── */
      .corner-badge {
        position: fixed;
        top: clamp(1.5rem, 4vw, 3rem);
        right: clamp(1.5rem, 4vw, 3rem);
        z-index: 10;
        text-align: right;
        opacity: 0;
        animation: rise 0.9s ease forwards 1.3s;
      }

      .badge-label {
        display: block;
        font-family: 'Faculty Glyphic', sans-serif;
        font-weight: 400;
        font-size: 0.65rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 0.3rem;
      }

      .badge-coming {
        display: block;
        font-family: 'Faculty Glyphic', sans-serif;
        color: var(--text-primary);
        letter-spacing: 0.05em;
      }

      /* ── Animations ── */
      @keyframes rise {
        to { opacity: 1; transform: translateY(0); }
      }
    </style>
  </head>
  <body>
    <div class="bg"></div>
    <div class="overlay-dark"></div>
    <div class="overlay-vignette"></div>

    <!-- Top-right: Coming Soon badge -->
    <div class="corner-badge">
      <span class="badge-label">Status</span>
      <span class="badge-coming">Coming Soon</span>
    </div>

    <!-- Bottom-left: Main content -->
    <main class="stage">
      <p class="eyebrow">Work in Progress</p>
      <h1 class="heading">Web Portfolio</h1>
      <div class="rule"></div>
      <p class="blurb">
        <span>Data. Web Dev. Design.</span>
        <span>Coming in 2026.</span>
      </p>

      <nav class="social-row" aria-label="Contact links">
        <!-- LinkedIn -->
        <a href="https://linkedin.com/in/erika-nieves" class="social-link" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
        <div class="social-dot" aria-hidden="true"></div>
        <!-- Email -->
        <a href="mailto:erika@erikanieves.com" class="social-link">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          erika@erikanieves.com
        </a>
      </nav>
    </main>
  </body>
</html>